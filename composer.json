{
    "name": "spomky-labs/access-control-framework",
    "description": "Authorization for PHP and Symfony: decides whether a requester is allowed to perform an action on a subject.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "access control",
        "authorization",
        "voter",
        "permission",
        "rbac",
        "abac",
        "xacml",
        "symfony",
        "symfony-bundle",
        "bundle"
    ],
    "authors": [
        {
            "name": "Florent Morselli",
            "homepage": "https://github.com/Spomky"
        },
        {
            "name": "All contributors",
            "homepage": "https://github.com/spomky-labs/access-control-framework/contributors"
        }
    ],
    "homepage": "https://github.com/spomky-labs/access-control-framework",
    "require": {
        "php": ">=8.4",
        "composer-runtime-api": ">=2.1",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/http-kernel": "^8.1"
    },
    "require-dev": {
        "matthiasnoback/symfony-config-test": "^6.0",
        "matthiasnoback/symfony-dependency-injection-test": "^6.0",
        "phpunit/phpunit": "^13.3",
        "psr/cache": "^3.0",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^8.1",
        "symfony/clock": "^8.1",
        "symfony/console": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/security-core": "^8.1",
        "symfony/security-http": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/var-dumper": "^8.1",
        "symfony/web-profiler-bundle": "^8.1",
        "symfony/workflow": "^8.1",
        "symfony/yaml": "^8.1",
        "twig/twig": "^3.12 || ^4.0"
    },
    "replace": {
        "spomky-labs/access-control-bundle": "self.version",
        "spomky-labs/access-control-lib": "self.version"
    },
    "suggest": {
        "spomky-labs/access-control-bundle": "Integration of the library into the Symfony full-stack framework",
        "symfony/expression-language": "Required to use the expression voter and expression-based policies",
        "symfony/security-core": "Required to reuse the voters, the role hierarchy and the tokens of the Security component",
        "symfony/workflow": "Required to guard workflow transitions",
        "twig/twig": "Required to use the is_granted() and access_decision() template functions"
    },
    "autoload": {
        "psr-4": {
            "AccessControl\\": "src/library/src/",
            "AccessControl\\Bundle\\": "src/symfony/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AccessControl\\Tests\\": "tests/library/",
            "AccessControl\\Tests\\Bundle\\": "tests/symfony/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "thanks": {
            "name": "spomky-labs/access-control-framework",
            "url": "https://github.com/spomky-labs/access-control-framework"
        }
    }
}
